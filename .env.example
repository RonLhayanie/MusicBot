# Telegram
TELEGRAM_TOKEN=
# Optional. Locks dashboard notifications to one chat. Strongly recommended in production.
TELEGRAM_OWNER_CHAT_ID=

# Google Gemini
GEMINI_API_KEY=

# Spotify application credentials (developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the Spotify app
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Obtained once by visiting /login and copying the value printed by /callback
SPOTIFY_REFRESH_TOKEN=

# MongoDB connection string
MONGO_URI=
